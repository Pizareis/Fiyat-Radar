# Local dev default (no setup needed):
DATABASE_URL=sqlite:///./fiyatradar.db
# Switch to Postgres (docker compose up -d) for closer-to-prod setup:
# DATABASE_URL=postgresql+psycopg2://fiyatradar:fiyatradar@localhost:5432/fiyatradar
COLLECT_INTERVAL_MINUTES=5
ANOMALY_ZSCORE_THRESHOLD=3.0
ANOMALY_WINDOW_SIZE=30
CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT
FOREX_PAIRS=USD-TRY,EUR-TRY,GBP-TRY
